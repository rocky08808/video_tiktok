# 网站对外访问地址（SEO / sitemap / OG），末尾不要斜杠
# 例：https://video.example.com
NEXT_PUBLIC_SITE_URL=

# R2 公开访问域名，末尾不要斜杠
# 例：https://pub-xxxxxxxx.r2.dev 或 https://video.example.com
NEXT_PUBLIC_R2_PUBLIC_BASE=

# 可选。设置后改用这份线上清单，不再读 src/data/catalog.json
# 清单里的 src 可以是相对路径（拼到上面的域名后）或完整 https 地址
# R2_MANIFEST_URL=https://pub-xxxxxxxx.r2.dev/manifest.json

# 可选。R2 没配 CORS 时设为 1，由 Next 代理 m3u8 和分片
# 代理只允许 NEXT_PUBLIC_R2_PUBLIC_BASE 这个域名下的文件
# HLS_PROXY=1

# 可选。服务端白名单如果要和浏览器看到的域名不同，再填这个
# R2_PUBLIC_BASE=

# 宝塔 MongoDB。密码里的特殊字符要做 URL 编码
# 本机 npm run dev：用服务器公网 IP，并放行 27017
# 网站部署在这台宝塔上：主机改成 127.0.0.1
# 宝塔创建的用户，authSource 填数据库名，不是 admin
MONGODB_URI=mongodb://video_user:密码@1.2.3.4:27017/video?authSource=video
# MONGODB_DB=video
# MONGODB_COLLECTION=videos
# MONGODB_PICS_COLLECTION=pics

# 管理后台账号（/admin），不要用普通用户名注册同名账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成足够长的密码

# VIP 充值收款地址（USDT-TRC20），浏览器可见
NEXT_PUBLIC_VIP_USDT_ADDRESS=Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram 客服（已转账未开通时联系），填 @username 或 https://t.me/username
NEXT_PUBLIC_TG_SUPPORT=
# 可选。TronGrid API Key，查链到账用；不填也能查，额度更小
# TRONGRID_API_KEY=
